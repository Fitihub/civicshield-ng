# Copy this file to .env for local development and fill in your own key.
# In production, set these in the Netlify dashboard instead
# (Site configuration -> Environment variables).

GROQ_API_KEY=your_groq_api_key_here

# Optional overrides — only needed if Groq changes its model lineup again.
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
